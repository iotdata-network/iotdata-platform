#!/usr/bin/env python3

# --------------------------------------------------------------------------------------

"""esp32-tool: work with an ESP32 over USB serial from a host with NO IDF toolchain —
flash it, watch it, drive its CLI, and pull its diagnostics off it.

Built for the split workflow: build on a fast toolchain host (e.g. workshop), then
flash and watch on the target host (e.g. iotdata-tst-3) where the boards are plugged
in. The target needs only python3 + pyserial and, for flashing, esptool — NOT the
compiler/cmake/ninja toolchain.

Subcommands:
    flash     write a build dir's bootloader + partition-table + app to the chip
    monitor   print the serial console, interactive (type to the device's CLI); reconnects.
              Does NOT reset by default (so it won't reboot a running node) — pass -r to reset.
              Redirected to a file it is a recorder: no colour, and a line at a time.
    reset     pulse the reset line and exit. For a board with no console this is the only way
              to put it back into a known state without reaching for the cable.
    command   issue ONE command to a running device and print just its response (C-tagged
              lines), filtering out log noise — for scripting. e.g. `command vers`.
    content   put a file into a node's content store over the console, or pull one back out
              (`content insert <id> <file>` / `content get <id> <file>`). The device paces the
              upload itself -- see the window note in iotdata_node_console_content.h -- so this
              runs as fast as the node can write flash and no faster.
    diag      pull the blackbox diagnostics partition off the chip and decode it to CSV
              (`diag extract`), or decode an image pulled earlier (`diag decode <file>`).
              Uses esptool only — no IDF toolchain — and is much faster than streaming the
              records over the console, or erase it (`diag clear --confirm`). NB these
              RESET the device.
    deploy    flash, then monitor  (the usual verb)

The build dir is any ESP-IDF `build/` directory: everything needed (chip, flash
settings, the three binaries and their offsets) is read from its flasher_args.json,
so this works for any project without hardcoding offsets.

Examples:
    # board on ttyACM0, artifacts already local (shared FS, or copied over):
    esp32-tool deploy -p /dev/ttyACM0 -b ../simulator_sensor_lora_esp32/build

    # pull the artifacts off the build host first, then flash + monitor:
    esp32-tool deploy -p /dev/ttyACM1 \
        --pull workshop:/opt/iotdata/src/iotdata-example/simulator_sensor_lora_esp32/build

    # watch a running board and type commands to its CLI (help / vers / stat / logl):
    esp32-tool monitor -p /dev/ttyACM0

    # one-shot: ask a running board for its version, print just the response:
    esp32-tool command -p /dev/ttyACM0 vers

    # flash only, no monitor:
    esp32-tool flash -p /dev/ttyACM0 -b ../relay/build

    # put an OTA bundle on a node and ask it what it makes of it (nothing applies it):
    esp32-tool content insert -p /dev/ttyACM0 0537a1 relay-0.9.9+full+deflate.bin
    esp32-tool command -p /dev/ttyACM0 "content inspect 0537a1"
    esp32-tool content get -p /dev/ttyACM0 0537a1 back.bin      # and check it round-tripped

    # pull weeks of field diagnostics off a node (flush first: the read resets it):
    esp32-tool command -p /dev/ttyACM0 "diag flush"
    esp32-tool diag extract -p /dev/ttyACM0 --raw diag.bin --out diag.csv
    esp32-tool diag decode diag.bin          # offline, re-decode an image pulled earlier

Several identical boards on one host all enumerate as "USB JTAG/serial debug unit", and
ttyACM numbering moves across a reset or a re-enumerate. Name the BOARD instead: its USB
iSerial is the chip's MAC -- unique, and the same sn= it reports in VERSION.

    esp32-tool list                          # serial (MAC), port, by-id path
    esp32-tool deploy -s 14:63:93:6F:F0:90   # find that board, whatever it enumerated as
    esp32-tool deploy -s f090                # any unambiguous tail of the serial
    esp32-tool deploy -s 90 -p /dev/ttyACM0  # -p names the port, -s REFUSES if it is not that board

$ESP32_SERIAL sets it per shell, as $ESP32_PORT does for the port. /dev/serial/by-id/<...>
works too, and needs no udev rule -- the kernel builds it from the same serial.

Dependencies on the target host (none are the compiler toolchain):
    python3, pyserial          monitor           -- already present for esp32-boot
    esptool                    flash             -- `pip install esptool`
    rsync + ssh                --pull only
"""

# --------------------------------------------------------------------------------------

import argparse
import base64
import json
import os
import re
import select
import shutil
import struct
import subprocess
import sys
import tempfile
import time

# --------------------------------------------------------------------------------------

def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)

VERBOSE = False

def verbose(msg):
    if VERBOSE:
        print(msg, file=sys.stderr)

# --------------------------------------------------------------------------------------

COLORS = {
    "E": "\033[31m",  # red
    "W": "\033[33m",  # yellow
    "I": "\033[32m",  # green
    "C": "\033[36m",  # cyan — iotdata command output ("C (<ms>) ...")
}
RESET = "\033[0m"
RED = "\033[31m"
CYAN = "\033[36m"

# COLOUR IS FOR A TERMINAL; A FILE IS EVIDENCE. Redirected, a monitor is a recorder -- for a node
# with no console it is the only observation there is -- and whoever reads that file later greps it.
# ANSI codes are noise in it. Buffering matters more: python block-buffers stdout to a pipe or file,
# so a line can sit unwritten for minutes, which reads exactly like a node that went quiet. Every
# line is flushed as it arrives, and a reader tailing the file sees what the board said when it
# said it.
TTY_OUT = sys.stdout.isatty()

def paint(code, text):
    return f"{code}{text}{RESET}" if TTY_OUT else text
LOG_RE = re.compile(r"^[CIDEW] \(\d+\) ")
# Command output is a pseudo log line "C (<ms>) <message>" (iotdata_command.h). Capture the message.
CMD_RE = re.compile(r"^C \(\d+\) (.*)$")
COMMAND_REQUEST = "COMMAND:REQUEST"

# A transcript of a monitor session. Written alongside the terminal output, never instead of it,
# because the point is to leave a run going and read it afterwards -- an overnight relay soak, a
# fault that takes hours to recur. Lines carry a wall-clock stamp so two boards' logs (and a
# gateway's) can be lined up against each other; the device's own "(3652885)" is uptime, which
# cannot be compared across boards.
_log_fh = None
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")

def log_open(spec, port):
    """Open the transcript for `spec` and return its path (None when not logging).

    A timestamp is inserted before the extension -- `-l relay.log` writes `relay-20260911T121530.log`
    -- so a re-run never appends to, or overwrites, the run you are still reading. Give a directory
    (or a path ending in /) to get `esp32-<stamp>.log` inside it."""
    global _log_fh
    if not spec:
        return None
    stamp = time.strftime("%Y%m%dT%H%M%S")
    if spec.endswith(os.sep) or os.path.isdir(spec):
        path = os.path.join(spec, f"esp32-{stamp}.log")
    else:
        root, ext = os.path.splitext(spec)
        path = f"{root}-{stamp}{ext or '.log'}"
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, exist_ok=True)
    _log_fh = open(path, "a", buffering=1)  # line buffered: readable with tail -f while it runs
    _log_fh.write(f"# esp32-tool monitor {port} started {time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n")
    return path

def log_line(text):
    if _log_fh is not None:
        _log_fh.write(f"{time.strftime('%H:%M:%S')} {_ANSI_RE.sub('', text)}\n")

def print_line(line):
    match = LOG_RE.match(line)
    if TTY_OUT and match and line[0] in COLORS:
        print(f"{COLORS[line[0]]}{line}{RESET}", flush=True)
    else:
        print(line, flush=True)
    log_line(line)

# --------------------------------------------------------------------------------------
# WHICH BOARD IS THIS?
#
# Several identical boards on one host all enumerate as "USB JTAG/serial debug unit", and ttyACM
# numbering is assigned in the order they happen to appear -- so it moves across a reset, and after
# a reboot the board you flashed yesterday may not be the one you flash today.
#
# What saves it is that the ESP32-C3/S3 USB-Serial-JTAG reports the chip's MAC as its USB iSerial.
# That is unique per board, the kernel already exposes it (/dev/serial/by-id, and ATTRS{serial} in
# sysfs), and it is the SAME value the node reports as sn= in its VERSION TLV -- so one identifier
# names the board on the bench, in udev, and in the fleet.
# --------------------------------------------------------------------------------------

def serial_norm(spec):
    """A board's identity however it was written: 14:63:93:6F:F0:90, 1463936ff090, 14-63-...."""
    return re.sub(r"[^0-9a-fA-F]", "", spec or "").lower() or None

def board_serial(port):
    """The USB iSerial behind a tty -- the chip's MAC. None if this port is not a USB device."""
    try:
        node = os.path.basename(os.path.realpath(port))
        d = os.path.realpath(f"/sys/class/tty/{node}/device")
        for _ in range(4):  # the tty hangs off an interface; the serial is on the device above it
            f = os.path.join(d, "serial")
            if os.path.exists(f):
                with open(f) as fh:
                    return fh.read().strip()
            d = os.path.dirname(d)
    except OSError:
        pass
    return None

def boards():
    """Every attached USB serial device, as (port, serial), sorted by port."""
    found = []
    try:
        nodes = os.listdir("/sys/class/tty")
    except OSError:
        return found
    for node in sorted(nodes):
        if not (node.startswith("ttyACM") or node.startswith("ttyUSB")):
            continue
        port = "/dev/" + node
        sn = board_serial(port)
        if sn:
            found.append((port, sn))
    return found

def board_find(spec, wait=False):
    """The port of the board with this serial. As short a TAIL as is UNAMBIGUOUS -- `-s 90` is fine
    when only one board ends in 90, and the boards on a bench usually differ in the last byte. It
    is uniqueness that makes this safe, not length: two matches is an error, never a guess."""
    want = serial_norm(spec)
    if not want:
        die(f"-s {spec}: expected a board serial (its MAC) or a tail of one, e.g. 14:63:93:6F:F0:90, 1463936ff090, or 90")
    announced = False
    while True:
        hits = [(p, sn) for p, sn in boards() if serial_norm(sn) == want or serial_norm(sn).endswith(want)]
        if len(hits) == 1:
            if announced:
                print()
            return hits[0][0]
        if len(hits) > 1:
            die(f"-s {spec} matches {len(hits)} boards: " + ", ".join(f"{sn} on {p}" for p, sn in hits) + " -- give more of the tail")
        if not wait:
            attached = boards()
            listing = "\n  ".join(f"{sn}  {p}" for p, sn in attached) if attached else "(none attached)"
            die(f"no board with serial {spec}. Attached:\n  {listing}")
        if not announced:
            print(f"waiting for board {spec} (Ctrl-C to give up)", end="", flush=True)
            announced = True
        print(".", end="", flush=True)
        time.sleep(0.5)

def port_select(args):
    """-s picks the board, -p names the port, and both together means -p with -s as a GUARD."""
    port, spec = getattr(args, "port", None), getattr(args, "serial", None)
    if spec and not port:
        return board_find(spec, wait=getattr(args, "wait", False))
    return port or os.environ.get("ESP32_PORT", "/dev/ttyACM0")

def do_list():
    attached = boards()
    if not attached:
        print("no USB serial devices attached")
        return 1
    for port, sn in attached:
        by_id = ""
        d = "/dev/serial/by-id"
        for name in sorted(os.listdir(d)) if os.path.isdir(d) else []:
            if os.path.realpath(os.path.join(d, name)) == os.path.realpath(port):
                by_id = os.path.join(d, name)
                break
        print(f"{sn}  {port}  {by_id}")
    return 0

def wait_for_port(port, timeout=None):
    """Block until `port` exists. Returns True if it appeared, False on timeout.

    Polls at 10ms because the window can be short: a board that deep-sleeps between cycles is
    only enumerated for a few seconds, and losing that window costs a whole sleep interval."""
    polls = 0
    while not os.path.exists(port):
        if timeout is not None and polls * 0.01 >= timeout:
            return False
        if polls % 50 == 0:
            print(".", end="", flush=True)
        polls += 1
        time.sleep(0.01)
    # The device node appears slightly before the CDC endpoint will accept a connection; without
    # this, grabbing it the instant it shows up can fail with a spurious "port is busy".
    time.sleep(0.05)
    return True

def require_port(args):
    """Every port-using subcommand's precondition: the port is there, or -w waits for it -- and it
    is the board we meant. The check is what makes -s safe to combine with a habitual -p: flashing
    the wrong one of three identical boards is otherwise silent, and only obvious later."""
    if not os.path.exists(args.port):
        if not getattr(args, "wait", False):
            die(f"{args.port} not found (use -w to wait for it)")
        print(f"waiting for {args.port} (Ctrl-C to give up)", end="", flush=True)
        wait_for_port(args.port)
        print()
    spec = getattr(args, "serial", None)
    if not spec:
        return
    want, got = serial_norm(spec), board_serial(args.port)
    if got is None:
        die(f"{args.port} reports no USB serial, so -s {spec} cannot be checked")
    if serial_norm(got) != want and not serial_norm(got).endswith(want):
        die(f"{args.port} is board {got}, not {spec} -- refusing")

# THE PULSE THAT RESETS A BOARD: RTS drives EN, DTR drives GPIO0. It is the same auto-reset the
# flashing tools use, which is why it needs no toolchain and no cooperation from the firmware -- and
# so it works on a board whose application has wedged, or which has no console to be told anything.
def reset_pulse(s):
    """Hold EN low briefly, GPIO0 high so the application boots and not the bootloader."""
    s.dtr = False
    s.rts = True
    time.sleep(0.15)
    s.rts = False
    time.sleep(0.05)

def do_reset(port):
    import serial  # lazily, as monitor does: `flash` works without pyserial
    try:
        with serial.Serial(port, 115200, timeout=1) as s:
            reset_pulse(s)
    except OSError as e:
        die(f"could not reset {port}: {e}")
    print(f"reset {port}")
    return 0

def monitor(port, command=None, reset=False, serial_want=None):
    import serial  # imported lazily so `flash` works without pyserial
    # Forward the terminal's stdin to the device so typed commands reach its console CLI. In cooked
    # mode a whole line arrives on Enter; we pass the bytes straight through (the device parses lines).
    try:
        stdin_fd = sys.stdin.fileno()
    except (ValueError, OSError, AttributeError):
        stdin_fd = None
    buf = b""
    first_connect = True
    while True:
        if not first_connect:
            print(paint(RED, "--- DEVICE DISCONNECTED"), flush=True)
            log_line("--- DEVICE DISCONNECTED")
            wait_for_port(port)
            # Same board? Three identical boards share one /dev node namespace, so a reconnect can
            # hand us a DIFFERENT one at the same path -- which is exactly what -s exists to stop.
            # Checking only at startup would let that through silently.
            if serial_want:
                got = board_serial(port)
                if got is None or (serial_norm(got) != serial_norm(serial_want) and not serial_norm(got).endswith(serial_norm(serial_want))):
                    print(paint(RED, f"--- {port} is board {got}, not {serial_want} -- still waiting"), flush=True)
                    while os.path.exists(port):
                        time.sleep(0.2)
                    continue
            print(paint(RED, "\n--- DEVICE RECONNECTED"), flush=True)
            log_line("--- DEVICE RECONNECTED")
            buf = b""
        try:
            with serial.Serial(port, 115200, timeout=0) as s:
                if first_connect:
                    if reset:
                        try:
                            reset_pulse(s)
                        except OSError:
                            pass
                    print(paint(CYAN, f"--- DEVICE CONNECTED {port}"), flush=True)
                    log_line(f"--- DEVICE CONNECTED {port}")
                    first_connect = False
                elif command:
                    # device is already booting — preload the command so it's in the
                    # buffer when the app's acquire step reads it
                    s.write(f"{command}\n".encode())
                    s.flush()
                    print(f"{CYAN}COMMAND:INJECT (preload): {command}{RESET}")
                watch = [s.fileno()] + ([stdin_fd] if stdin_fd is not None else [])
                while True:
                    ready, _, _ = select.select(watch, [], [], 0.2)
                    if stdin_fd is not None and stdin_fd in ready:
                        typed = os.read(stdin_fd, 256)
                        if typed:
                            s.write(typed)  # keystrokes/line -> device console
                            s.flush()
                        else:  # EOF on stdin — stop forwarding, keep monitoring
                            watch = [s.fileno()]
                            stdin_fd = None
                    if s.fileno() in ready:
                        data = s.read(s.in_waiting or 1)
                        if not data:
                            continue
                        buf += data
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            decoded = line.decode(errors="replace").rstrip("\r")
                            print_line(decoded)
                            if command and COMMAND_REQUEST in decoded:
                                s.write(f"{command}\n".encode())
                                s.flush()
                                print(f"{CYAN}COMMAND:INJECT: {command}{RESET}")
        except OSError:
            # Deliberately OSError and not serial.SerialException: SerialException is a SUBCLASS of
            # OSError, so catching it does not catch the bare OSError(EIO) that in_waiting's
            # fcntl.ioctl raises the moment the cable is pulled. That was a traceback and an exit
            # mid-session; the reconnect loop above was already correct and simply unreachable.
            #
            # The node usually vanishes with the cable, but not always -- and while it is still
            # there wait_for_port returns at once, so a port that fails every open would spin.
            # A short settle covers that and the never-connected case alike.
            if os.path.exists(port):
                time.sleep(0.2)
            continue

# --------------------------------------------------------------------------------------

def command_oneshot(port, cmd, reset=False, timeout=2.0):
    """Connect to a running device, issue one command, print its 'C (...)' response, exit.
    Returns 0 if any command output was captured, else 1. ESP_LOG noise is filtered out."""
    import serial
    try:
        with serial.Serial(port, 115200, timeout=0.1) as s:
            if reset:
                try:
                    s.dtr = False
                    s.rts = True
                    time.sleep(0.1)
                    s.rts = False
                    time.sleep(0.4)  # give the app a moment to come up
                except OSError:
                    pass
            try:
                s.reset_input_buffer()
            except OSError:
                pass
            s.write(f"{cmd}\n".encode())
            s.flush()
            buf = b""
            out = []
            deadline = time.time() + timeout
            while time.time() < deadline:
                data = s.read(s.in_waiting or 1)
                if not data:
                    continue
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    m = CMD_RE.match(line.decode(errors="replace").rstrip("\r"))
                    if m:
                        out.append(m.group(1))
                        deadline = time.time() + 0.4  # keep reading while output flows
    except serial.SerialException as e:
        die(f"serial: {e}")
    for line in out:
        print(line)
    return 0 if out else 1

# --------------------------------------------------------------------------------------
# CONTENT
#
# The console's two bulk words. Both are plain text over the same line the CLI uses, so this needs
# nothing but pyserial -- no esptool, no toolchain, and no reset: a node stays up and keeps relaying
# while a file goes onto it.
#
# A READER THREAD, because the device's own log lines have to be taken off it. A node that is
# logging LoRa frames fills its 256-byte transmit buffer in a few lines, and its printf then BLOCKS
# -- taking the main loop, and the console reads, down with it. Draining continuously is not an
# optimisation here, it is what keeps the transfer moving.
# --------------------------------------------------------------------------------------

CONTENT_ACK_RE = re.compile(r"insert ([0-9a-f]{6}) ack (\d+)")
CONTENT_READY_RE = re.compile(r"insert ([0-9a-f]{6}) ready, (\d+) bytes, lines of up to (\d+), window (\d+)")
CONTENT_DATA_RE = re.compile(r"^d (\d+) ([A-Za-z0-9+/=]+)$")

_CRC64_TABLE = []
for _i in range(256):
    _c = _i
    for _ in range(8):
        _c = (_c >> 1) ^ (0xC96C5795D7870F42 if _c & 1 else 0)
    _CRC64_TABLE.append(_c)

def crc64(data, crc=0):
    """CRC-64/XZ, liblzma's convention: start from 0 and the running value IS the answer, which is
    what iotdata_node_crc64() does and what the node will compare against."""
    c = (~crc) & 0xFFFFFFFFFFFFFFFF
    for b in data:
        c = (c >> 8) ^ _CRC64_TABLE[(c ^ b) & 0xFF]
    return (~c) & 0xFFFFFFFFFFFFFFFF

class _ConsoleLink:
    """A line-oriented view of the console, drained by a thread. `take()` empties the queue."""

    def __init__(self, port):
        import serial, threading
        self._s = serial.Serial(port, 115200, timeout=0.05)
        self._lines = []
        self._buf = b""
        self._lock = threading.Lock()
        self._stop = False
        try:
            self._s.reset_input_buffer()
        except OSError:
            pass
        self._t = threading.Thread(target=self._pump, daemon=True)
        self._t.start()

    def _pump(self):
        while not self._stop:
            try:
                data = self._s.read(4096)
            except Exception:
                return
            if not data:
                continue
            with self._lock:
                self._buf += data
                while b"\n" in self._buf:
                    one, self._buf = self._buf.split(b"\n", 1)
                    self._lines.append(one.decode("utf-8", "replace").rstrip("\r"))

    def send(self, line):
        self._s.write((line + "\n").encode())
        self._s.flush()

    def take(self):
        with self._lock:
            out, self._lines = self._lines, []
        return out

    def until(self, predicate, timeout):
        """Collect lines until one satisfies `predicate`. Returns (hit, lines)."""
        got = []
        deadline = time.time() + timeout
        while time.time() < deadline:
            new = self.take()
            got += new
            for line in new:
                if predicate(line):
                    return True, got
            if not new:
                time.sleep(0.002)
        return False, got

    def close(self):
        self._stop = True
        time.sleep(0.1)
        try:
            self._s.close()
        except OSError:
            pass

def do_content_insert(port, cid, path, timeout=60.0):
    """Upload a file, paced by the device's own credit window."""
    try:
        data = open(path, "rb").read()
    except OSError as e:
        die(f"content insert: {e}")
    if not data:
        die("content insert: nothing to send")
    link = _ConsoleLink(port)
    try:
        time.sleep(0.2)
        link.take()
        link.send(f"content insert {cid} {len(data)} {crc64(data):016x}")
        hit, got = link.until(lambda l: "ready," in l or "refused" in l, 5.0)
        ready = None
        for line in got:
            m = CMD_RE.match(line)
            if m:
                print(m.group(1))
                ready = ready or CONTENT_READY_RE.search(m.group(1))
        if ready is None:
            print("content insert: the node did not accept it", file=sys.stderr)
            return 1
        # THE DEVICE SAYS how big a line it will take and how far ahead we may run. Hardcoding
        # either would break silently the day the console's receive ring is resized.
        payload, window = int(ready.group(3)), int(ready.group(4))
        acked, failed, started = 0, False, time.time()
        for off in range(0, len(data), payload):
            while off - acked >= window and not failed:
                moved, lines = link.until(lambda l: CONTENT_ACK_RE.search(l) is not None, 20.0)
                for line in lines:
                    m = CMD_RE.match(line)
                    if not m:
                        continue
                    ack = CONTENT_ACK_RE.search(m.group(1))
                    if ack:
                        acked = max(acked, int(ack.group(2)))
                    else:
                        print(m.group(1))
                        failed = failed or ("failed" in m.group(1) or "gave up" in m.group(1) or "abandoned" in m.group(1))
                if not moved:
                    print(f"content insert: no credit past {off} of {len(data)} (acked {acked})", file=sys.stderr)
                    return 1
            if failed:
                break
            link.send("d %d %s" % (off, base64.b64encode(data[off:off + payload]).decode()))
        elapsed = time.time() - started
        # The verdict comes from the TICK, after the checksum and the rename -- not from the last
        # line being accepted, which only means it was written somewhere.
        hit, got = link.until(lambda l: "arrived" in l or "failed" in l, timeout)
        for line in got:
            m = CMD_RE.match(line)
            if m and " ack " not in m.group(1):
                print(m.group(1))
        rate = len(data) / elapsed if elapsed > 0 else 0
        print(f"--- {len(data)} bytes in {elapsed:.1f}s ({rate:.0f} B/s), {payload}B lines, {window}B window")
        return 0 if (hit and not failed) else 1
    finally:
        link.close()

def do_content_get(port, cid, path, timeout=180.0):
    """Download a file and verify it against the sum the node reports."""
    link = _ConsoleLink(port)
    try:
        time.sleep(0.2)
        link.take()
        link.send(f"content download {cid}")
        hit, got = link.until(lambda l: "done," in l or "FAILED" in l or "refused" in l, timeout)
        parts, said, want, bad = {}, [], None, False
        for line in got:
            m = CMD_RE.match(line)
            if not m:
                continue
            body = m.group(1)
            data = CONTENT_DATA_RE.match(body)
            if data:
                parts[int(data.group(1))] = base64.b64decode(data.group(2))
            else:
                said.append(body)
                bad = bad or ("refused" in body or "FAILED" in body)
                found = re.search(r"crc64=0x([0-9A-Fa-f]{16})", body)
                if found:
                    want = int(found.group(1), 16)
        for line in said:
            print(line)
        # A REFUSAL ENDS THE WAIT AND IS NOT AN END: `done,` is the only line that means the node
        # sent everything. Without this an unknown id wrote a zero-byte file and exited 0.
        if bad:
            return 1
        if not hit:
            print("content get: the node never finished", file=sys.stderr)
            return 1
        blob, gap = b"", None
        for off in sorted(parts):
            if off != len(blob) and gap is None:
                gap = off
            blob += parts[off]
        if gap is not None:
            print(f"content get: a line is missing around offset {gap}", file=sys.stderr)
            return 1
        got_crc = crc64(blob)
        if want is not None and want != got_crc:
            print(f"content get: crc64 0x{got_crc:016X} but the node said 0x{want:016X}", file=sys.stderr)
            return 1
        try:
            open(path, "wb").write(blob)
        except OSError as e:
            die(f"content get: {e}")
        print(f"--- {len(blob)} bytes, crc64=0x{got_crc:016X}{' (agrees)' if want is not None else ''} -> {path}")
        return 0
    finally:
        link.close()

